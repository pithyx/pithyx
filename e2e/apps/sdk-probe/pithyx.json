{
  "manifestVersion": 1,
  "id": "com.example.sdk-probe",
  "version": "1.0.0",
  "name": { "en": "SDK demo", "de": "SDK-Demo" },
  "description": {
    "en": "The E2E probe: a third-party app on @pithyx/sdk, installed from its package."
  },
  "author": { "name": "Pithyx E2E" },
  "license": "MIT",
  "entry": "frontend/index.html",
  "sdk": "^1.0.0-rc.1",
  "permissions": ["notifications"],
  "window": {
    "instances": "single",
    "defaultSize": { "width": 520, "height": 560 },
    "minSize": { "width": 320, "height": 320 }
  }
}
