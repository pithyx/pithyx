{
  "$comment": "The Compose subset an app backend may use (D310): the allowlist that @pithyx/cli (pithyx validate) and the box both read, so they judge a backend/compose.yaml alike. Every key not listed under `top`, `service` or a nested `keys` is refused with app.compose.key_unsupported. `type` names a check both validators implement; `right` names the elevated right of the manifest's backend.elevated that the key needs (checked in both directions). Patterns match the whole value. The box rewrites the file before use (project name, network, user, logging, mounts, limits, labels), so keys it sets itself are refused here. This file is a stable contract: allowing a key or loosening a limit is a minor change, anything else a major one.",
  "rulesVersion": 1,
  "limits": {
    "fileBytes": 65536,
    "depth": 10,
    "entries": 256,
    "services": 16,
    "volumes": 32,
    "shmSizeBytes": 268435456,
    "tmpfsSizeBytes": 268435456,
    "imageChars": 512,
    "memoryMinBytes": 6291456,
    "memoryMaxBytes": 274877906944,
    "cpus": 256
  },
  "patterns": {
    "serviceName": "^(?:[a-z0-9][a-z0-9_.-]{0,62})$",
    "volumeName": "^(?:[a-z0-9][a-z0-9_-]{0,62})$",
    "image": "^(?:(?:[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[0-9]{1,5})?/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?@sha256:[a-f0-9]{64})$",
    "imageDigest": "^(?:.*@sha256:[a-f0-9]{64})$",
    "envName": "^(?:[A-Za-z_][A-Za-z0-9_]{0,127})$",
    "labelKey": "^(?:[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?)$",
    "containerPath": "^(?:/(?:[^/\\u0000-\\u001f\\u007f:\\\\]+(?:/[^/\\u0000-\\u001f\\u007f:\\\\]+)*)?)$",
    "devicePath": "^(?:/dev(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)+)$",
    "devicePermissions": "^(?:r|w|rw)$",
    "capability": "^(?:(?!CAP_)[A-Z][A-Z0-9_]*)$",
    "signal": "^(?:SIG[A-Z][A-Z0-9]*(?:\\+[0-9]{1,2})?)$",
    "duration": "^(?=[0-9])(?:(?:[0-9]{1,9}h)?(?:[0-9]{1,9}m)?(?:[0-9]{1,9}s)?(?:[0-9]{1,9}ms)?(?:[0-9]{1,9}us)?)$",
    "byteSize": "^(?:[0-9]{1,12}(?:[bBkKmMgG]|[kKmMgG][bB])?)$",
    "port": "^(?:[0-9]{1,5}(?:-[0-9]{1,5})?(?:/(?:tcp|udp))?)$",
    "memorySize": "^(?:[0-9]{1,12}(?:[bBkKmMgG]|[kKmMgG][bB]))$",
    "cpus": "^(?:(?:0|[1-9][0-9]{0,2})(?:\\.[0-9]{1,3})?)$",
    "tmpfsMode": "^(?:[0-7]{3,4})$"
  },
  "top": {
    "services": { "type": "services", "required": true },
    "volumes": { "type": "volumeDeclarations" }
  },
  "service": {
    "image": { "type": "image", "required": true },
    "command": { "type": "command" },
    "entrypoint": { "type": "command" },
    "environment": { "type": "environment" },
    "working_dir": { "type": "string", "pattern": "containerPath" },
    "volumes": { "type": "mounts" },
    "tmpfs": { "type": "tmpfs" },
    "depends_on": { "type": "dependsOn" },
    "healthcheck": {
      "type": "object",
      "keys": {
        "test": { "type": "healthTest" },
        "interval": { "type": "duration", "min": "1s", "max": "1h" },
        "timeout": { "type": "duration", "min": "1s", "max": "1h" },
        "start_period": { "type": "duration", "min": "0s", "max": "1h" },
        "start_interval": { "type": "duration", "min": "1s", "max": "1h" },
        "retries": { "type": "int", "min": 1, "max": 100 },
        "disable": { "type": "bool" }
      }
    },
    "expose": { "type": "ports" },
    "read_only": { "type": "bool" },
    "init": { "type": "bool" },
    "stop_signal": { "type": "string", "pattern": "signal" },
    "stop_grace_period": { "type": "duration", "min": "0s", "max": "5m" },
    "shm_size": { "type": "byteSize", "max": "shmSizeBytes" },
    "mem_limit": {
      "type": "byteSize",
      "pattern": "memorySize",
      "min": "memoryMinBytes",
      "max": "memoryMaxBytes"
    },
    "cpus": { "type": "cpus", "max": "cpus" },
    "labels": { "type": "labels" },
    "network_mode": { "type": "enum", "values": ["host"], "right": "host.network" },
    "pid": { "type": "enum", "values": ["host"], "right": "host.pid" },
    "devices": { "type": "devices", "right": "device:" },
    "cap_drop": { "type": "capabilities" },
    "cap_add": { "type": "capabilities", "right": "capability:" },
    "privileged": { "type": "bool", "right": "host.full" }
  },
  "mount": {
    "keys": {
      "type": { "type": "enum", "values": ["volume", "tmpfs", "bind"], "required": true },
      "source": { "type": "string" },
      "target": { "type": "string", "pattern": "containerPath", "required": true },
      "read_only": { "type": "bool" },
      "tmpfs": {
        "type": "object",
        "keys": {
          "size": { "type": "byteSize", "max": "tmpfsSizeBytes" }
        }
      }
    },
    "reservedTargets": ["/proc", "/sys", "/dev"],
    "dockerSockets": ["/var/run/docker.sock", "/run/docker.sock"],
    "dockerSocketRight": "docker.socket"
  },
  "dependsOn": {
    "keys": {
      "condition": {
        "type": "enum",
        "values": ["service_started", "service_healthy", "service_completed_successfully"]
      },
      "restart": { "type": "bool" },
      "required": { "type": "bool" }
    }
  },
  "reservedLabelPrefixes": ["com.pithyx", "com.docker"],
  "refused": {
    "top": {
      "name": "the box sets the project name pithyx-<id>",
      "version": "obsolete in Compose v2",
      "networks": "the box creates the app's network",
      "secrets": "reads files or the box's environment",
      "configs": "reads files or the box's environment",
      "include": "reads other files",
      "x-*": "useless without anchors, which are refused"
    },
    "service": {
      "ports": "backends are reached only through the proxy",
      "build": "the box never builds images",
      "networks": "the box attaches the app's network",
      "links": "service names resolve on the app's network",
      "external_links": "reaches other projects",
      "volumes_from": "can reach another app's volumes",
      "env_file": "reads files",
      "secrets": "reads files or the box's environment",
      "configs": "reads files or the box's environment",
      "label_file": "reads files",
      "extends": "reads other files",
      "profiles": "every service runs",
      "container_name": "the box names containers per project",
      "user": "the box sets the app uid, or root with backend.root",
      "group_add": "the box adds the share groups of mapped storage",
      "restart": "the box runs the lifecycle",
      "logging": "the box sets journald",
      "deploy": "use mem_limit and cpus",
      "scale": "one container per service",
      "mem_reservation": "use mem_limit",
      "memswap_limit": "use mem_limit",
      "mem_swappiness": "box policy",
      "cpu_shares": "use cpus",
      "cpu_quota": "use cpus",
      "cpu_period": "use cpus",
      "cpuset": "box policy",
      "pids_limit": "the box sets 1024 against fork bombs",
      "blkio_config": "box policy",
      "oom_kill_disable": "can stall the host",
      "oom_score_adj": "the box sets it so app containers go before its own services",
      "security_opt": "could switch off seccomp, AppArmor or no-new-privileges",
      "device_cgroup_rules": "could open every device",
      "gpus": "needs a runtime the box does not ship",
      "runtime": "needs a runtime the box does not ship",
      "isolation": "not on Linux",
      "userns_mode": "host would switch off the user namespace",
      "ipc": "host or another container's IPC namespace",
      "uts": "host's UTS namespace",
      "cgroup": "host's cgroup namespace",
      "cgroup_parent": "would leave the app's limits",
      "sysctls": "kernel settings",
      "ulimits": "box policy",
      "storage_opt": "box policy",
      "extra_hosts": "host-gateway reaches the box",
      "dns": "the app's network resolves service names",
      "dns_search": "see dns",
      "dns_opt": "see dns",
      "hostname": "not needed on the app's network",
      "domainname": "not needed on the app's network",
      "mac_address": "network identity",
      "platform": "images come per architecture from images.lock.json",
      "pull_policy": "the box loads or pulls by digest itself",
      "tty": "no terminal",
      "stdin_open": "no terminal",
      "attach": "no terminal",
      "annotations": "not needed",
      "develop": "no development mode on the box (D307)",
      "post_start": "not in Compose 2.26",
      "pre_stop": "not in Compose 2.26",
      "x-*": "useless without anchors, which are refused"
    },
    "volume": {
      "driver": "volumes are folders in the app's dataset",
      "driver_opts": "could mount any device or host path",
      "external": "reaches volumes outside the app",
      "name": "reaches volumes outside the app",
      "labels": "not needed"
    },
    "mount": {
      "bind": "host paths are never mounted",
      "volume": "subpath and nocopy are not needed",
      "consistency": "not on Linux"
    }
  }
}
