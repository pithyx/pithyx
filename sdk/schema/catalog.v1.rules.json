{
  "$comment": "The rules a pull request to a catalog repository must pass (D328), as data. `pithyx catalog check` applies them in the catalog's CI on the app folder after the pull request, and the box reads the same file, so both judge alike (the corpus in fixtures/catalog/rules). The owner still reviews every pull request; these rules only catch what a machine can. Paths are relative to the app folder `apps/<id>/` unless named otherwise. A file is text when its name is in `text.names`, matches `dockerfile`, or its extension (after the last dot, lowercase) is in `text.extensions`; text must be UTF-8 without NUL and without a line longer than `limits.lineChars` (except `text.longLines`), and a name matching `minified` is refused. A file whose extension is in `media` must start with its magic bytes. Every other file is refused, as are folders and files starting with a dot other than the listed names. Every FROM of a Dockerfile, and every `--from` of COPY and ADD that is not an earlier stage, names an image pinned with @sha256 or `scratch`. Licenses are SPDX expressions whose every license and exception is listed; `LicenseRef-` is refused. This file is a stable contract: loosening a rule or adding a license is a minor change, anything else a major one.",
  "rulesVersion": 1,
  "appsFolder": "apps",
  "reservedIds": {
    "prefix": "org.pithyx.",
    "catalogs": ["org.pithyx.official"]
  },
  "limits": {
    "appBytes": 5242880,
    "lineChars": 1000,
    "screenshots": 8,
    "screenshotBytes": 1048576
  },
  "requiredFiles": [
    ["pithyx.json"],
    ["icon.svg"],
    ["maintainers.json"],
    ["LICENSE", "LICENSE.md", "LICENSE.txt"]
  ],
  "manifestFields": ["license", "pithyx"],
  "text": {
    "names": [
      ".dockerignore",
      ".editorconfig",
      ".gitignore",
      ".npmrc",
      ".nvmrc",
      ".prettierignore",
      ".prettierrc",
      "LICENSE",
      "Makefile",
      "NOTICE"
    ],
    "extensions": [
      "c",
      "cjs",
      "conf",
      "cs",
      "csproj",
      "css",
      "cts",
      "go",
      "gradle",
      "graphql",
      "h",
      "html",
      "ini",
      "java",
      "js",
      "json",
      "jsonc",
      "jsx",
      "kt",
      "lock",
      "md",
      "mjs",
      "mod",
      "mts",
      "po",
      "properties",
      "proto",
      "py",
      "rb",
      "rs",
      "scss",
      "sh",
      "slnx",
      "sql",
      "sum",
      "svelte",
      "svg",
      "toml",
      "ts",
      "tsx",
      "txt",
      "vue",
      "xml",
      "yaml",
      "yml"
    ],
    "longLines": ["svg"]
  },
  "dockerfile": "^(?:(?:Dockerfile|Containerfile)(?:\\.[A-Za-z0-9_-]{1,64})?|[A-Za-z0-9_][A-Za-z0-9_-]{0,63}\\.(?:Dockerfile|Containerfile))$",
  "minified": "\\.min\\.(?:js|mjs|cjs|css)$",
  "media": {
    "gif": {
      "type": "image/gif",
      "magic": [
        {
          "offset": 0,
          "hex": "47494638"
        }
      ]
    },
    "jpeg": {
      "type": "image/jpeg",
      "magic": [
        {
          "offset": 0,
          "hex": "ffd8ff"
        }
      ]
    },
    "jpg": {
      "type": "image/jpeg",
      "magic": [
        {
          "offset": 0,
          "hex": "ffd8ff"
        }
      ]
    },
    "png": {
      "type": "image/png",
      "magic": [
        {
          "offset": 0,
          "hex": "89504e470d0a1a0a"
        }
      ]
    },
    "webp": {
      "type": "image/webp",
      "magic": [
        {
          "offset": 0,
          "hex": "52494646"
        },
        {
          "offset": 8,
          "hex": "57454250"
        }
      ]
    },
    "woff2": {
      "type": "font/woff2",
      "magic": [
        {
          "offset": 0,
          "hex": "774f4632"
        }
      ]
    }
  },
  "screenshots": {
    "folder": "screenshots",
    "name": "^[a-z0-9][a-z0-9_-]{0,62}\\.(?:png|jpg|webp)$"
  },
