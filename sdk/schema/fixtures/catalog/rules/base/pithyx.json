{
  "$schema": "https://pithyx.org/schema/manifest.v2.schema.json",
  "manifestVersion": 2,
  "id": "com.example.notes",
  "version": "1.1.0",
  "name": {
    "en": "Notes",
    "de": "Notizen"
  },
  "description": {
    "en": "Notes for everyone on the box.",
    "de": "Notizen für alle auf der Box."
  },
  "author": {
    "name": "Jan Example",
    "url": "https://example.com"
  },
  "license": "MIT",
  "homepage": "https://example.com/notes",
  "entry": "frontend/index.html",
  "sdk": "^1.0.0",
  "pithyx": ">=0.1.0",
  "dataVersion": 1,
  "arch": [
    "amd64",
    "arm64"
  ],
  "source": "https://example.com/notes",
  "privacy": {
    "sends": "none"
  },
  "permissions": {},
  "window": {
    "instances": "multi",
    "defaultSize": {
      "width": 800,
      "height": 600
    },
    "minSize": {
      "width": 400,
      "height": 300
    }
  },
  "backend": {
    "compose": "backend/compose.yaml",
    "endpoints": {
      "api": {
        "service": "server",
        "port": 8080
      }
    },
    "lifecycle": "onDemand"
  }
}
