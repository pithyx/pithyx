{
  "manifestVersion": 1,
  "id": "io.gitlab.jan-k.photo-tools.viewer",
  "version": "2.0.0-rc.1",
  "name": {
    "en": "Photo viewer",
    "de": "Fotobetrachter",
    "pt-BR": "Visualizador"
  },
  "author": {
    "name": "Example"
  },
  "entry": "frontend/index.html",
  "sdk": "1.0.0 - 1.4.0 || ^2.0.0-rc.1 || >=3 <4",
  "permissions": [
    "files.read",
    "files.write",
    "files.shares"
  ],
  "window": {
    "instances": "single",
    "defaultSize": {
      "width": 800,
      "height": 600
    },
    "minSize": {
      "width": 800,
      "height": 600
    }
  },
  "description": {
    "en": "Shows photos.\nAlso videos."
  },
  "license": "(MIT OR Apache-2.0)",
  "homepage": "http://example.org/viewer?x=1",
  "storage": [
    {
      "id": "library",
      "name": {
        "en": "Photo library"
      },
      "description": {
        "en": "Where your photos are."
      },
      "access": "read",
      "required": true,
      "services": [
        "web",
        "worker-1"
      ]
    },
    {
      "id": "cache-2",
      "name": {
        "en": "Cache"
      },
      "access": "readWrite",
      "required": false
    }
  ],
  "fileHandlers": [
    {
      "extensions": [
        "jpg",
        "jpeg"
      ],
      "mimeTypes": [
        "image/jpeg"
      ],
      "isDefault": true
    },
    {
      "extensions": [
        "tar.gz",
        "x-y_z"
      ]
    }
  ],
  "backend": {
    "compose": "backend/stack/compose.yaml",
    "endpoints": {
      "api": {
        "service": "web",
        "port": 8080
      },
      "thumbs-v2": {
        "service": "worker-1",
        "port": 1
      }
    },
    "lifecycle": "always",
    "idleTimeout": 60,
    "root": true,
    "health": {
      "endpoint": "thumbs-v2",
      "path": "/"
    },
    "schedules": [
      {
        "id": "nightly",
        "cron": "*/15 0-6,22-23 1 1-12/2 7",
        "endpoint": "api",
        "path": "/jobs/nightly?full=1"
      },
      {
        "id": "weekly",
        "cron": "0 0 * * 0",
        "endpoint": "thumbs-v2",
        "path": "/jobs/weekly"
      }
    ],
    "elevated": [
      "capability:NET_ADMIN",
      "host.network",
      "host.pid",
      "device:/dev/dri/renderD128"
    ]
  }
}
