{
  "manifestVersion": 2,
  "id": "com.example.notes",
  "version": "0.1.0",
  "name": {
    "en": "Notes"
  },
  "author": {
    "name": "Example"
  },
  "entry": "frontend/index.html",
  "sdk": "^1.0.0",
  "arch": [
    "amd64",
    "arm64"
  ],
  "source": "https://github.com/example/app",
  "permissions": {
    "files.read": {
      "reason": {
        "en": "Opens the files you choose."
      }
    }
  },
  "window": {
    "instances": "multi",
    "defaultSize": {
      "width": 640,
      "height": 480
    },
    "minSize": {
      "width": 320,
      "height": 240
    }
  },
  "fileActions": [
    {
      "id": "extract",
      "label": {
        "en": "Extract here"
      },
      "extensions": [
        "zip"
      ],
      "writes": true
    }
  ]
}
