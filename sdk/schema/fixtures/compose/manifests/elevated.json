{
  "manifestVersion": 2,
  "id": "com.example.chat",
  "version": "1.2.0",
  "name": {
    "en": "Chat"
  },
  "author": {
    "name": "Example"
  },
  "entry": "frontend/index.html",
  "sdk": "^1.0.0",
  "arch": [
    "amd64",
    "arm64"
  ],
  "source": "https://github.com/example/app",
  "permissions": {
    "host.network": {
      "reason": {
        "en": "Needs host.network for its background service."
      }
    },
    "host.pid": {
      "reason": {
        "en": "Needs host.pid for its background service."
      }
    },
    "device:/dev/dri/renderD128": {
      "reason": {
        "en": "Needs device:/dev/dri/renderD128 for its background service."
      }
    },
    "device:/dev/ttyUSB0": {
      "reason": {
        "en": "Needs device:/dev/ttyUSB0 for its background service."
      }
    }
  },
  "window": {
    "instances": "single",
    "defaultSize": {
      "width": 900,
      "height": 640
    },
    "minSize": {
      "width": 320,
      "height": 400
    }
  },
  "backend": {
    "compose": "backend/compose.yaml",
    "endpoints": {
      "api": {
        "service": "server",
        "port": 8080
      }
    },
    "lifecycle": "onDemand",
    "root": false
  }
}
