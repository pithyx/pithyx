{
  "manifestVersion": 2,
  "id": "com.example.chat",
  "version": "1.2.0",
  "name": {
    "en": "Chat"
  },
  "author": {
    "name": "Example"
  },
  "entry": "frontend/index.html",
  "sdk": "^1.0.0",
  "arch": [
    "amd64",
    "arm64"
  ],
  "source": "https://github.com/example/app",
  "permissions": {},
  "window": {
    "instances": "single",
    "defaultSize": {
      "width": 900,
      "height": 640
    },
    "minSize": {
      "width": 320,
      "height": 400
    }
  },
  "backend": {
    "compose": "backend/compose.yaml",
    "endpoints": {
      "api": {
        "service": "server",
        "port": 8080
      },
      "metrics": {
        "service": "worker",
        "port": 9090
      }
    },
    "lifecycle": "onDemand"
  },
  "storage": [
    {
      "id": "attachments",
      "name": {
        "en": "Chat attachments"
      },
      "access": "readWrite",
      "required": true,
      "services": [
        "server",
        "worker"
      ]
    },
    {
      "id": "library",
      "name": {
        "en": "Library"
      },
      "access": "read",
      "required": false,
      "services": [
        "server"
      ]
    },
    {
      "id": "exports",
      "name": {
        "en": "Exports"
      },
      "access": "readWrite",
      "required": false
    }
  ]
}
