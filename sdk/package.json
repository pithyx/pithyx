{
  "name": "@pithyx/sdk",
  "version": "0.0.0",
  "description": "SDK for building Pithyx apps",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "schema/*.json",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "pithyx-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "pithyx-source": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./i18n": {
      "pithyx-source": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./schema/manifest.v1.schema.json": "./schema/manifest.v1.schema.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "generate": "node scripts/generate-manifest.ts"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "intl-messageformat": "^11.2.15"
  }
}
