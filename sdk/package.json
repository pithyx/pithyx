{
  "name": "@pithyx/sdk",
  "version": "1.0.0-rc.3",
  "description": "SDK for building Pithyx apps: the API between an app and the Pithyx desktop",
  "keywords": [
    "pithyx",
    "sdk",
    "nas",
    "self-hosted",
    "apps",
    "desktop"
  ],
  "homepage": "https://github.com/pithyx/pithyx/tree/dev/sdk#readme",
  "bugs": {
    "url": "https://github.com/pithyx/pithyx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithyx/pithyx.git",
    "directory": "sdk"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "schema/*.json",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "pithyx-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "pithyx-source": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./i18n": {
      "pithyx-source": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./schema/manifest.v1.schema.json": "./schema/manifest.v1.schema.json",
    "./schema/compose.v1.rules.json": "./schema/compose.v1.rules.json",
    "./schema/images-lock.v1.schema.json": "./schema/images-lock.v1.schema.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "generate": "node scripts/generate-manifest.ts",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0",
    "typedoc": "^0.28.20",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "intl-messageformat": "^11.2.15"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./host": {
        "types": "./dist/host.d.ts",
        "import": "./dist/host.js"
      },
      "./i18n": {
        "types": "./dist/i18n.d.ts",
        "import": "./dist/i18n.js"
      },
      "./schema/manifest.v1.schema.json": "./schema/manifest.v1.schema.json",
      "./schema/compose.v1.rules.json": "./schema/compose.v1.rules.json",
      "./schema/images-lock.v1.schema.json": "./schema/images-lock.v1.schema.json"
    }
  }
}
