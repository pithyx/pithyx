{
  "name": "@vyxis/sdk",
  "version": "0.0.0",
  "description": "SDK for building Vyxis apps",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "vyxis-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "vyxis-source": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./i18n": {
      "vyxis-source": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "intl-messageformat": "^11.2.15"
  }
}
