          "code": {
            "type": [
              "null",
              "string"
            ],
            "description": "Six-digit code from the authenticator app."
          },
          "recoveryCode": {
            "type": [
              "null",
              "string"
            ],
            "description": "One of the recovery codes shown when TOTP was enabled, instead of a code."
          }
        }
