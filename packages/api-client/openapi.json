{
  "openapi": "3.1.1",
  "info": {
    "title": "Vyxis API",
    "version": "v1"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiProblem": {
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "params",
          "requestId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "params": {
            "type": "object",
            "additionalProperties": { }
          },
          "requestId": {
            "type": "string"
          }
        },
        "description": "RFC 9457 problem details as returned by every failing API call. The detail text is an English fallback;\nclients show the translation of the error code instead."
      },
      "DaemonMode": {
        "enum": [
          "real",
          "simulated"
        ]
      },
      "ErrorCode": {
        "enum": [
          "request.body.invalid",
          "request.media_type.unsupported",
          "request.method.not_allowed",
          "request.route.not_found",
          "system.internal.unexpected"
        ],
        "type": "string"
      },
      "HealthResponse": {
        "required": [
          "status",
          "mode"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/DaemonMode"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "System"
    }
  ]
}