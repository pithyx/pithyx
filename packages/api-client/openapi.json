{
  "openapi": "3.1.1",
  "info": {
    "title": "Vyxis API",
    "version": "v1"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/disks": {
      "get": {
        "tags": [
          "Storage"
        ],
        "operationId": "GetDisks",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiskList"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/setup": {
      "get": {
        "tags": [
          "Setup"
        ],
        "operationId": "GetSetupStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Setup"
        ],
        "operationId": "Setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupResponse"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login/totp": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "LoginTotp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/recover": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "Recover",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoverRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoverResponse"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "Logout",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "GetSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/totp/enroll": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "EnrollTotp",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpEnrollment"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/totp/confirm": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "ConfirmTotp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodes"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/totp/disable": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "DisableTotp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpDisableRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "Problem details with a stable error code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AckMessage": {
        "required": [
          "id",
          "type",
          "requestId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "ack"
            ],
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "description": "Confirms a `sub` or `unsub`. For `sub`, the snapshots of matching topics follow."
      },
      "ApiProblem": {
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "params",
          "requestId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "params": {
            "type": "object",
            "additionalProperties": { }
          },
          "requestId": {
            "type": "string"
          }
        },
        "description": "RFC 9457 problem details as returned by every failing API call. The detail text is an English fallback;\nclients show the translation of the error code instead."
      },
      "ClientMessage": {
        "required": [
          "type",
          "id",
          "topic"
        ],
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "sub",
              "unsub"
            ],
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Chosen by the client; echoed in the ack, snapshots and errors that answer this message."
          },
          "topic": {
            "type": "string",
            "description": "Topic name or pattern with `+` and `#`."
          }
        },
        "description": "A message from the client: `sub` or `unsub` for a topic or pattern."
      },
      "DaemonMode": {
        "enum": [
          "real",
          "simulated"
        ]
      },
      "Disk": {
        "required": [
          "id",
          "name",
          "path",
          "serial",
          "wwn",
          "model",
          "vendor",
          "sizeBytes",
          "rotational",
          "transport",
          "removable",
          "readOnly",
          "partitions"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable across reboots and device renames: `wwn-...`, else `serial-...`, else `path-...`."
          },
          "name": {
            "type": "string",
            "description": "Kernel name, for example `sda` or `nvme0n1`. Can change between boots."
          },
          "path": {
            "type": "string",
            "description": "Device node, for example `/dev/sda`."
          },
          "serial": {
            "type": [
              "null",
              "string"
            ],
            "description": "Serial number as reported by the drive, if any."
          },
          "wwn": {
            "type": [
              "null",
              "string"
            ],
            "description": "World wide name, if any."
          },
          "model": {
            "type": [
              "null",
              "string"
            ],
            "description": "Model name, if any."
          },
          "vendor": {
            "type": [
              "null",
              "string"
            ],
            "description": "Vendor, if any."
          },
          "sizeBytes": {
            "type": "integer",
            "description": "Capacity in bytes.",
            "format": "int64"
          },
          "rotational": {
            "type": "boolean",
            "description": "True for spinning disks."
          },
          "transport": {
            "type": [
              "null",
              "string"
            ],
            "description": "Bus, for example `sata`, `nvme` or `usb`; null for virtual disks."
          },
          "removable": {
            "type": "boolean",
            "description": "True for removable media."
          },
          "readOnly": {
            "type": "boolean",
            "description": "True when the kernel exposes the disk read-only."
          },
          "partitions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Partition"
            },
            "description": "Partitions in on-disk order."
          }
        }
      },
      "DiskList": {
        "required": [
          "disks"
        ],
        "type": "object",
        "properties": {
          "disks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Disk"
            }
          }
        },
        "description": "Snapshot of `storage/disks` and response of `GET /api/disks`."
      },
      "DisksChanged": {
        "required": [
          "upserts",
          "removals"
        ],
        "type": "object",
        "properties": {
          "upserts": {
            "type": "array",
            "items": {
              "required": [
                "id",
                "name",
                "path",
                "serial",
                "wwn",
                "model",
                "vendor",
                "sizeBytes",
                "rotational",
                "transport",
                "removable",
                "readOnly",
                "partitions"
              ],
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable across reboots and device renames: `wwn-...`, else `serial-...`, else `path-...`."
                },
                "name": {
                  "type": "string",
                  "description": "Kernel name, for example `sda` or `nvme0n1`. Can change between boots."
                },
                "path": {
                  "type": "string",
                  "description": "Device node, for example `/dev/sda`."
                },
                "serial": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "Serial number as reported by the drive, if any."
                },
                "wwn": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "World wide name, if any."
                },
                "model": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "Model name, if any."
                },
                "vendor": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "Vendor, if any."
                },
                "sizeBytes": {
                  "type": "integer",
                  "description": "Capacity in bytes.",
                  "format": "int64"
                },
                "rotational": {
                  "type": "boolean",
                  "description": "True for spinning disks."
                },
                "transport": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "Bus, for example `sata`, `nvme` or `usb`; null for virtual disks."
                },
                "removable": {
                  "type": "boolean",
                  "description": "True for removable media."
                },
                "readOnly": {
                  "type": "boolean",
                  "description": "True when the kernel exposes the disk read-only."
                },
                "partitions": {
                  "type": "array",
                  "items": {
                    "required": [
                      "name",
                      "path",
                      "sizeBytes",
                      "fileSystem",
                      "label",
                      "mountPoints"
                    ],
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Kernel name, for example `sda1`."
                      },
                      "path": {
                        "type": "string",
                        "description": "Device node."
                      },
                      "sizeBytes": {
                        "type": "integer",
                        "description": "Size in bytes.",
                        "format": "int64"
                      },
                      "fileSystem": {
                        "type": [
                          "null",
                          "string"
                        ],
                        "description": "File system or content type, for example `ext4` or `zfs_member`."
                      },
                      "label": {
                        "type": [
                          "null",
                          "string"
                        ],
                        "description": "File system label, if any."
                      },
                      "mountPoints": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Where the partition is mounted; empty when it is not."
                      }
                    }
                  },
                  "description": "Partitions in on-disk order."
                }
              }
            }
          },
          "removals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "Event of `storage/disks`: disks that appeared or changed, and ids of disks that disappeared."
      },
      "ErrorCode": {
        "enum": [
          "auth.challenge.expired",
          "auth.credentials.invalid",
          "auth.csrf.header_missing",
          "auth.display_name.invalid",
          "auth.password.too_common",
          "auth.password.too_long",
          "auth.password.too_short",
          "auth.permission.denied",
          "auth.rate.limited",
          "auth.recovery.invalid",
          "auth.session.expired",
          "auth.setup.already_done",
          "auth.totp.already_enabled",
          "auth.totp.invalid",
          "auth.totp.not_enrolled",
          "auth.username.invalid",
          "auth.username.reserved",
          "realtime.message.invalid",
          "realtime.topic.invalid",
          "realtime.topic.unknown",
          "realtime.upgrade.required",
          "request.body.invalid",
          "request.media_type.unsupported",
          "request.method.not_allowed",
          "request.route.not_found",
          "system.internal.unexpected",
          "system.origin.forbidden"
        ],
        "type": "string"
      },
      "ErrorMessage": {
        "required": [
          "id",
          "code",
          "params",
          "type",
          "requestId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "params": {
            "type": "object",
            "additionalProperties": { }
          },
          "type": {
            "enum": [
              "error"
            ],
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "description": "A failed client message. `id` is empty when the message could not be parsed."
      },
      "EventMessage": {
        "required": [
          "topic",
          "data",
          "type",
          "requestId"
        ],
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "data": { },
          "type": {
            "enum": [
              "event"
            ],
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "description": "A change of a topic. `requestId` is the id of the action that caused it, if any."
      },
      "HealthResponse": {
        "required": [
          "status",
          "mode"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/DaemonMode"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "required": [
          "user",
          "totpRequired",
          "challenge"
        ],
        "type": "object",
        "properties": {
          "user": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Set when the login is complete.",
                "$ref": "#/components/schemas/UserInfo"
              }
            ]
          },
          "totpRequired": {
            "type": "boolean",
            "description": "True when a TOTP or recovery code must follow."
          },
          "challenge": {
            "type": [
              "null",
              "string"
            ],
            "description": "Pass to `/api/auth/login/totp` within five minutes."
          }
        }
      },
      "Partition": {
        "required": [
          "name",
          "path",
          "sizeBytes",
          "fileSystem",
          "label",
          "mountPoints"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Kernel name, for example `sda1`."
          },
          "path": {
            "type": "string",
            "description": "Device node."
          },
          "sizeBytes": {
            "type": "integer",
            "description": "Size in bytes.",
            "format": "int64"
          },
          "fileSystem": {
            "type": [
              "null",
              "string"
            ],
            "description": "File system or content type, for example `ext4` or `zfs_member`."
          },
          "label": {
            "type": [
              "null",
              "string"
            ],
            "description": "File system label, if any."
          },
          "mountPoints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Where the partition is mounted; empty when it is not."
          }
        }
      },
      "RecoverRequest": {
        "required": [
          "username",
          "recoveryKey",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "recoveryKey": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "RecoverResponse": {
        "required": [
          "recoveryKey"
        ],
        "type": "object",
        "properties": {
          "recoveryKey": {
            "type": "string",
            "description": "The new recovery key. The old one no longer works."
          }
        }
      },
      "RecoveryCodes": {
        "required": [
          "codes"
        ],
        "type": "object",
        "properties": {
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shown exactly once. Each code replaces a TOTP code for one login."
          }
        }
      },
      "ServerMessage": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AckMessage"
          },
          {
            "$ref": "#/components/schemas/SnapshotMessage"
          },
          {
            "$ref": "#/components/schemas/EventMessage"
          },
          {
            "$ref": "#/components/schemas/ErrorMessage"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "ack": "#/components/schemas/AckMessage",
            "snap": "#/components/schemas/SnapshotMessage",
            "event": "#/components/schemas/EventMessage",
            "error": "#/components/schemas/ErrorMessage"
          }
        }
      },
      "SetupRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SetupResponse": {
        "required": [
          "user",
          "recoveryKey"
        ],
        "type": "object",
        "properties": {
          "user": {
            "description": "The administrator, already signed in.",
            "$ref": "#/components/schemas/UserInfo"
          },
          "recoveryKey": {
            "type": "string",
            "description": "Shown exactly once. It is the only way to reset the administrator password."
          }
        }
      },
      "SetupStatus": {
        "required": [
          "required",
          "hostname"
        ],
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean",
            "description": "True until the first administrator exists."
          },
          "hostname": {
            "type": "string",
            "description": "Shown on the setup and sign-in screens, so users with several servers know where they sign in."
          }
        }
      },
      "SnapshotMessage": {
        "required": [
          "id",
          "topic",
          "data",
          "type",
          "requestId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "data": { },
          "type": {
            "enum": [
              "snap"
            ],
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "description": "The full current state of a topic, sent after `sub`. Only changes follow as events."
      },
      "SystemInfo": {
        "required": [
          "hostname",
          "uptimeSeconds",
          "loadAverage",
          "cpuPercent",
          "memoryTotalBytes",
          "memoryAvailableBytes"
        ],
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string",
            "description": "The host name of the box."
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Seconds since boot.",
            "format": "double"
          },
          "loadAverage": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "description": "Over 1, 5 and 15 minutes."
          },
          "cpuPercent": {
            "type": [
              "null",
              "number"
            ],
            "description": "Usage since the previous sample; null for the very first one.",
            "format": "double"
          },
          "memoryTotalBytes": {
            "type": "integer",
            "description": "Physical memory.",
            "format": "int64"
          },
          "memoryAvailableBytes": {
            "type": "integer",
            "description": "Memory available for new work without swapping, including reclaimable caches.",
            "format": "int64"
          }
        }
      },
      "TopicEvents": {
        "required": [
          "storage/disks",
          "system/info"
        ],
        "type": "object",
        "properties": {
          "storage/disks": {
            "$ref": "#/components/schemas/DisksChanged"
          },
          "system/info": {
            "$ref": "#/components/schemas/SystemInfo"
          }
        }
      },
      "TopicSnapshots": {
        "required": [
          "storage/disks",
          "system/info"
        ],
        "type": "object",
        "properties": {
          "storage/disks": {
            "$ref": "#/components/schemas/DiskList"
          },
          "system/info": {
            "$ref": "#/components/schemas/SystemInfo"
          }
        }
      },
      "TotpConfirmRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "TotpDisableRequest": {
        "required": [
          "password"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "TotpEnrollment": {
        "required": [
          "secret",
          "uri"
        ],
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Base32 secret for manual entry."
          },
          "uri": {
            "type": "string",
            "description": "otpauth:// URI for the QR code."
          }
        }
      },
      "TotpLoginRequest": {
        "required": [
          "challenge"
        ],
        "type": "object",
        "properties": {
          "challenge": {
            "type": "string",
