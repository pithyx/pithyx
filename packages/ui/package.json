{
  "name": "@pithyx/ui",
  "version": "0.0.0",
  "description": "React components and design tokens of the Pithyx desktop, for Pithyx apps",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "tokens.css",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "pithyx-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "pithyx-source": "./src/native.ts",
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "build": "vite build",
    "css-types": "node ../../tools/css-module-types.ts packages/ui",
    "typecheck": "node ../../tools/css-module-types.ts packages/ui && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  }
}
