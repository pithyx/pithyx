{
  "name": "@pithyx/ui",
  "version": "1.0.0-rc.8",
  "description": "React components and design tokens of the Pithyx desktop, for Pithyx apps",
  "keywords": [
    "pithyx",
    "ui",
    "react",
    "components",
    "design-tokens",
    "apps"
  ],
  "homepage": "https://github.com/pithyx/pithyx/tree/dev/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/pithyx/pithyx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithyx/pithyx.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "tokens.css",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "pithyx-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "pithyx-source": "./src/native.ts",
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "build": "node ../../tools/css-module-types.ts packages/ui && vite build",
    "css-types": "node ../../tools/css-module-types.ts packages/ui",
    "typecheck": "node ../../tools/css-module-types.ts packages/ui && tsc -p tsconfig.json",
    "test": "vitest run",
    "docs": "node ../../tools/css-module-types.ts packages/ui && typedoc",
    "docs:check": "node ../../tools/css-module-types.ts packages/ui && typedoc --emit none"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typedoc": "^0.28.20",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./native": {
        "types": "./dist/native.d.ts",
        "import": "./dist/native.js"
      },
      "./tokens.css": "./tokens.css"
    }
  }
}
