<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Pithyx.Daemon</RootNamespace>
    <AssemblyName>pithyxd</AssemblyName>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../packages/api-client</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    <!-- Source-generated P/Invoke for the Linux file calls (Files/LinuxFs.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <!-- The image publishes the daemon self-contained for these (image/build.sh); restoring them always keeps packages.lock.json the same everywhere. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Certes" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Fido2" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- Image decoding for thumbnails (MIT). Linux x64 and arm64 native builds without system libraries; the Windows
         and macOS builds SkiaSharp pulls in are never used. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" ExcludeAssets="all" />
    <!-- The Compose validator reads the YAML event stream itself (Apps/Compose/ComposeYaml.cs). -->
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pithyx.Daemon.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../i18n/en/errors.json" LogicalName="i18n/en/errors.json" />
    <EmbeddedResource Include="../../../i18n/en/notifications.json" LogicalName="i18n/en/notifications.json" />
    <EmbeddedResource Include="../../../i18n/en/jobs.json" LogicalName="i18n/en/jobs.json" />
    <EmbeddedResource Include="../../../i18n/de/notifications.json" LogicalName="i18n/de/notifications.json" />
    <EmbeddedResource Include="../../../i18n/de/jobs.json" LogicalName="i18n/de/jobs.json" />
    <EmbeddedResource Include="../../../i18n/de/errors.json" LogicalName="i18n/de/errors.json" />
    <EmbeddedResource Include="Database/Migrations/*.sql" LogicalName="migrations/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Auth/common-passwords.txt" LogicalName="auth/common-passwords.txt" />
    <EmbeddedResource Include="../../../sdk/schema/manifest.v1.schema.json" LogicalName="schema/manifest.v1.schema.json" />
    <EmbeddedResource Include="../../../sdk/schema/compose.v1.rules.json" LogicalName="schema/compose.v1.rules.json" />
    <EmbeddedResource Include="../../../sdk/schema/catalog.v1.schema.json" LogicalName="schema/catalog.v1.schema.json" />
    <EmbeddedResource Include="../../../sdk/schema/catalog.v1.rules.json" LogicalName="schema/catalog.v1.rules.json" />
    <EmbeddedResource Include="../../../sdk/schema/index.v1.schema.json" LogicalName="schema/index.v1.schema.json" />
    <EmbeddedResource Include="../../../sdk/schema/index-signature.v1.schema.json" LogicalName="schema/index-signature.v1.schema.json" />
    <EmbeddedResource Include="../../../sdk/schema/maintainers.v1.schema.json" LogicalName="schema/maintainers.v1.schema.json" />
    <EmbeddedResource Include="../../../tools/release/schema/update-manifest.v1.schema.json" LogicalName="schema/update-manifest.v1.schema.json" />
    <EmbeddedResource Include="../../../tools/release/schema/update-channel.v1.schema.json" LogicalName="schema/update-channel.v1.schema.json" />
    <EmbeddedResource Include="../../../tools/release/schema/update-source.v1.schema.json" LogicalName="schema/update-source.v1.schema.json" />
  </ItemGroup>
</Project>
