==> /etc/systemd/network/10-pithyx-enp1s0.network
# Managed by pithyx. Pithyx writes this file again on every change of the network in Settings.

[Match]
Name=enp1s0

[Link]
MTUBytes=9000

[Network]
DHCP=ipv4
IPv6AcceptRA=yes
LinkLocalAddressing=ipv6

[DHCPv4]
ClientIdentifier=mac
UseHostname=no
RouteMetric=1024

[IPv6AcceptRA]
RouteMetric=1024

[DHCPv6]
UseHostname=no

