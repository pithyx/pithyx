==> /etc/systemd/network/10-pithyx-bond0.netdev
# Managed by pithyx. Pithyx writes this file again on every change of the network in Settings.

[NetDev]
Name=bond0
Kind=bond

[Bond]
Mode=active-backup
MIIMonitorSec=100ms

==> /etc/systemd/network/10-pithyx-bond0.network
# Managed by pithyx. Pithyx writes this file again on every change of the network in Settings.

[Match]
Name=bond0

[Network]
DHCP=no
IPv6AcceptRA=no
LinkLocalAddressing=no
VLAN=vlan42

==> /etc/systemd/network/10-pithyx-enp1s0.network
# Managed by pithyx. Pithyx writes this file again on every change of the network in Settings.

[Match]
Name=enp1s0

[Network]
Bond=bond0

