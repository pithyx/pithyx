# Managed by pithyx. Pithyx writes this file again on every change; put your own settings into /etc/samba/pithyx.local.conf.

[global]
   server role = standalone server
   workgroup = WORKGROUP
   server string = Pithyx
   server min protocol = SMB3
   server signing = mandatory
   map to guest = never
   restrict anonymous = 2
   usershare max shares = 0
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   disable netbios = yes
   smb ports = 445
   passdb backend = tdbsam
   obey pam restrictions = yes
   unix password sync = no
   logging = systemd
   log level = 1
   nt acl support = no
   store dos attributes = yes
   map archive = no
   map hidden = no
   map system = no
   map readonly = no
   follow symlinks = yes
   wide links = no
   vfs objects = catia fruit streams_xattr
   fruit:metadata = stream
   fruit:model = MacSamba
   fruit:posix_rename = yes
   fruit:nfs_aces = no
   fruit:wipe_intentionally_left_blank_rfork = yes
   fruit:delete_empty_adfiles = yes
   include = /etc/samba/pithyx.local.conf

[Media]
   path = /tank/pithyx/shares/media
   browseable = yes
   access based share enum = yes
   valid users = "ada" "rita" "tom"
   read only = yes
   write list = "ada" "rita"
   server smb encrypt = if_required
   inherit acls = no
   create mask = 0660
   directory mask = 0770
   veto files = /.pithyx-trash/
   delete veto files = no
   vfs objects = full_audit catia fruit streams_xattr shadow_copy2 recycle
   recycle:repository = .pithyx-trash/.smb/%U
   recycle:keeptree = yes
   recycle:versions = yes
   recycle:touch = no
   recycle:directory_mode = 0700
   recycle:subdir_mode = 0700
   shadow:snapdir = .zfs/snapshot
   shadow:format = pithyx-daily-%Y%m%dT%H%M%SZ
   shadow:localtime = no
   shadow:sort = desc
   full_audit:prefix = %U|%S
   full_audit:success = pwrite_send unlinkat renameat mkdirat
   full_audit:failure = none
   full_audit:facility = LOCAL5
   full_audit:priority = DEBUG

[Private Files]
   path = /tank/pithyx/shares/private_files
   browseable = yes
   access based share enum = yes
   valid users = "pithyx-nobody"
   read only = yes
   write list = "pithyx-nobody"
   server smb encrypt = required
   inherit acls = no
   create mask = 0660
   directory mask = 0770
   veto files = /.pithyx-trash/
   delete veto files = no
   vfs objects = full_audit catia fruit streams_xattr shadow_copy2 recycle
   recycle:repository = .pithyx-trash/.smb/%U
   recycle:keeptree = yes
   recycle:versions = yes
   recycle:touch = no
   recycle:directory_mode = 0700
   recycle:subdir_mode = 0700
   shadow:snapdir = .zfs/snapshot
   shadow:format = pithyx-daily-%Y%m%dT%H%M%SZ
   shadow:localtime = no
   shadow:sort = desc
   full_audit:prefix = %U|%S
   full_audit:success = pwrite_send unlinkat renameat mkdirat
   full_audit:failure = none
   full_audit:facility = LOCAL5
   full_audit:priority = DEBUG
