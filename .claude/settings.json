{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push * stable)",
      "Bash(git push * stable *)",
      "Bash(git push * *:stable)",
      "Bash(git push * *:stable *)",
      "Bash(git push * +stable*)",
      "Bash(git push * :stable*)",
      "Bash(git push * --delete stable*)",
      "Bash(git push * beta)",
      "Bash(git push * beta *)",
      "Bash(git push * *:beta)",
      "Bash(git push * *:beta *)",
      "Bash(git push * +beta*)",
      "Bash(git push * :beta*)",
      "Bash(git push * --delete beta*)",
      "Bash(git push * +dev*)",
      "Bash(git push * :dev*)",
      "Bash(git push * --delete dev*)"
    ]
  }
}
