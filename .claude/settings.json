{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push * *:master)",
      "Bash(git push * *:master *)",
      "Bash(git push * +master*)",
      "Bash(git push * :master*)",
      "Bash(git push * --delete master*)",
      "Bash(git push * +dev*)",
      "Bash(git push * :dev*)",
      "Bash(git push * --delete dev*)"
    ]
  }
}
