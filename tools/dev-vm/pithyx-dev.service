# Managed by pithyx: tools/dev-vm/install-dev-daemon.sh fills in @REPO@ and installs this unit on the dev VM.
# The daemon runs as root in real mode, like on a box, but from a checkout: a development aid, never a product unit.
[Unit]
Description=Pithyx daemon (dev VM, real mode, from @REPO@)
After=network-online.target zfs.target
Wants=network-online.target
# A daemon that keeps failing stops after five tries in two minutes instead of restarting forever.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@REPO@/daemon/src/Pithyx.Daemon
Environment=ASPNETCORE_ENVIRONMENT=Development
Environment=PITHYX_SIMULATE=0
Environment=PITHYX_DB=/var/lib/pithyx/pithyx.db
Environment=PITHYX_LOG_DIR=/var/log/pithyx
Environment=PITHYX_CACHE_DIR=/var/cache/pithyx
Environment=PITHYX_DESKTOP_DIR=@REPO@/desktop/dist
# The reverse proxy's ports (D347), so its hosts can be tried on the dev VM like on a box.
Environment=PITHYX_DEV_PROXY_PORTS=80,443
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
ExecStart=/usr/bin/dotnet @REPO@/daemon/src/Pithyx.Daemon/bin/Release/net10.0/pithyxd.dll
Restart=on-failure
RestartSec=2
# App containers get oom_score_adj 500 (D310): when memory runs out, the kernel ends them long before the daemon.
OOMScoreAdjust=-900
# 65: a newer daemon wrote the database (DaemonExitCode.DatabaseNewerThanDaemon); restarting cannot fix it.
RestartPreventExitStatus=65

[Install]
WantedBy=multi-user.target
