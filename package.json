{
  "name": "vyxis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @vyxis/desktop dev",
    "design": "pnpm --filter @vyxis/desktop design",
    "design:shots": "node tools/design-shots/render.ts",
    "design:test": "playwright test -c tools/design-shots/playwright.config.ts",
    "lint": "pnpm --filter @vyxis/desktop css-types && eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @vyxis/e2e e2e",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "dotnet build daemon/Vyxis.slnx && pnpm --filter @vyxis/api-client generate",
    "check:repo": "node tools/checks/repo-check.ts",
    "check:commits": "node tools/checks/commit-msg.ts --range",
    "check:dco": "node tools/checks/dco.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
