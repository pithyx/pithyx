# The Debian base of the image, the packages and the update files: Debian 13 pinned to one snapshot.debian.org date,
# so every build from the same commit gets the same packages (D296). Sourced by image/build.sh and tools/release/*.sh.
SNAPSHOT=20261001T000000Z
SUITE=trixie
ARCH=amd64
DOTNET_RID=linux-x64
