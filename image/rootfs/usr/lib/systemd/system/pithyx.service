# Managed by pithyx: shipped in the image (image/rootfs). The same unit runs the installer on the live system, where
# the kernel command line carries pithyx.installer, and the NAS on the installed system.
[Unit]
Description=Pithyx daemon
# Not after network-online.target: the daemon listens on every address and must start without a cable as well.
After=network.target zfs.target zfs-import.target
# A daemon that keeps failing stops after five tries in two minutes instead of restarting forever.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/usr/lib/pithyx/daemon
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_gcServer=0
ExecStart=/usr/lib/pithyx/daemon/pithyxd
Restart=on-failure
RestartSec=2
# App containers get oom_score_adj 500 (D310): when memory runs out, the kernel ends them long before the daemon.
OOMScoreAdjust=-900
# 65: a newer daemon wrote the database; 78: a second installation. Restarting cannot fix either. 75 (restart
# requested after a restore) is not listed, so systemd starts the daemon again.
RestartPreventExitStatus=65 78

[Install]
WantedBy=multi-user.target
