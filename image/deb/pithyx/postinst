#!/bin/sh
# Managed by pithyx (image/deb/pithyx). Enables the units of the box. Nothing restarts here: an update reboots into the
# new version after its snapshot, and the running daemon must not stop in the middle of its own update.
set -e

if [ "$1" = configure ]; then
  systemctl enable pithyx.service pithyx-issue.service pithyx-console.service pithyx-update-health.service >/dev/null 2>&1 || true
  # tty1 belongs to the console menu (D337); the box has no local login (D341).
  for tty in 1 2 3 4 5 6; do
    systemctl mask "getty@tty$tty.service" "autovt@tty$tty.service" >/dev/null 2>&1 || true
  done
  # The SSH greeting is Pithyx's (/etc/update-motd.d/10-pithyx), not Debian's uname line and license text.
  chmod -x /etc/update-motd.d/10-uname 2>/dev/null || true
  if [ -f /etc/motd ] && grep -q 'Debian GNU/Linux comes with' /etc/motd; then
    : >/etc/motd
  fi
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi
fi
exit 0
